# ==========================================
# OLAB - Variáveis de Ambiente de Exemplo
# ==========================================

# 1. Chave da API Google Gemini (para análises de IA no servidor)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# 2. Configurações de Autenticação (Better Auth)
# URL base do sistema (em produção: https://seu-dominio.com)
BETTER_AUTH_URL=http://localhost:3000

# Chave secreta de alta entropia para assinatura de tokens de sessão (gerar com `openssl rand -hex 32`)
BETTER_AUTH_SECRET=insira_uma_chave_aleatoria_longa_e_segura_aqui

# 3. Provedores Sociais OAuth (Opcional)
# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
